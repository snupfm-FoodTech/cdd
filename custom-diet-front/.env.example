# Backend URL used by Next.js server as the /api/* rewrite destination.
# Browser-side requests use the relative path /api which Next.js proxies to this URL.
# Must include BE context-path (/api).
BACKEND_INTERNAL_URL='http://localhost:8080/api'

NEXT_PUBLIC_BASE_PATH=""

# FE↔service-page navigation URLs. Use relative paths to stay host-independent.
# Override only if FE and service-page are hosted on different origins.
CD_APP='/'
CD_APP_ADMIN='/cms/'
NEXT_PUBLIC_CD_SERVICE='/service-page'

# Feature flags
NEXT_PUBLIC_FEATURE_ALLERGEN=true
