# custom-diet 전역 공유 환경변수
#
# 이 파일을 `.env` 로 복사한 뒤 필요한 값만 수정하세요.
#   cp .env.example .env
#
# 미설정 시 docker-compose.yml 의 ${VAR:-기본값} 치환과
# deploy/application.properties 의 ${VAR:기본값} 플레이스홀더가
# 다음 값들로 폴백합니다.

# --- PostgreSQL (postgres, custom-diet-api 공유) ---
POSTGRES_USER=diet
POSTGRES_PASSWORD=diet
POSTGRES_DB=diet
POSTGRES_PORT=5432
# docker-compose 스택 내부에서는 서비스명(postgres)을 사용.
# 스택 외부에서 단독 실행 시에는 localhost 로 두세요.
POSTGRES_HOST=postgres

# --- 공개 주소 (custom-diet-api 가 사용) ---
PUBLIC_URL=http://localhost/api
CORS_ALLOW_ORIGIN=https://localhost
