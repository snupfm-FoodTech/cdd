# Backend URL used by Next.js server only (rewrite destination + any future SSR).
# Browser never sees this value — it always calls the relative path /api.
# Must include BE context-path (/api).
BACKEND_INTERNAL_URL='http://custom-diet-api:8080/api'

NEXT_PUBLIC_BASE_PATH=""

# FE↔service-page navigation URLs. Relative paths assume nginx fronts both on the same origin.
CD_APP='/'
CD_APP_ADMIN='/cms/'
NEXT_PUBLIC_CD_SERVICE='/service-page'

# Feature flags
NEXT_PUBLIC_FEATURE_ALLERGEN=false
