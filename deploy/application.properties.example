spring.config.use-legacy-processing=true

Globals.LocalIp=127.0.0.1
# 환경변수 PUBLIC_URL 로 override 가능. 미설정 시 아래 기본값 사용.
Globals.PublicUrl=${PUBLIC_URL:http://localhost/api}

Globals.DbType=postgresql

# Page Config
Globals.pageUnit=10
Globals.pageSize=10

# File Config
Globals.posblAtchFileSize=5242880
Globals.fileStorePath=./files
Globals.addedOptions=false

# PostgreSQL — 환경변수(POSTGRES_*)로 주입, 미설정 시 아래 기본값 사용.
# docker-compose 스택 외부 단독 실행 시 host 기본값은 localhost.
Globals.postgresql.DriverClassName=org.postgresql.Driver
Globals.postgresql.Url=jdbc:postgresql://${POSTGRES_HOST:localhost}:${POSTGRES_PORT:5432}/${POSTGRES_DB:diet}
Globals.postgresql.UserName=${POSTGRES_USER:diet}
Globals.postgresql.Password=${POSTGRES_PASSWORD:diet}

# Allowed file extensions
Globals.fileUpload.Extensions.Images = .gif.jpg.jpeg.png
Globals.fileUpload.Extensions = .gif.jpg.jpeg.png.xls.xlsx

# CORS — 환경변수 CORS_ALLOW_ORIGIN 으로 override.
Globals.Allow.Origin = ${CORS_ALLOW_ORIGIN:https://localhost}

# Crypto algorithm
Globals.crypto.algoritm = egovframe

# JWT secret (반드시 강력한 랜덤 값으로 교체)
Globals.jwt.secret = <CHANGE_ME_TO_A_LONG_RANDOM_SECRET>

server.servlet.context-path=/api
server.port = 8080
server.servlet.session.timeout=3600
spring.mvc.pathmatch.matching-strategy=ant_path_matcher

# Logging
logging.root.level=INFO
logging.file.name=backend
logging.file.path=./log
logging.rollingpolicy.maxFileSize=10MB
logging.rollingpolicy.maxHistory=30

# SpringDoc
springdoc.version=v4.2.0
springdoc.packages-to-scan=egovframework
springdoc.swagger-ui.tags-sorter=alpha
springdoc.swagger-ui.operations-sorter=method
springdoc.swagger-ui.doc-expansion=none
springdoc.api-docs.path=/v3/api-docs
springdoc.api-docs.groups.enabled=true
springdoc.cache.disabled=true

# Mail (Gmail SMTP example)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=<MAIL_USER>
spring.mail.password=<MAIL_APP_PASSWORD>
spring.mail.properties.mail.transport.protocol=smtp
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.ssl.protocols=TLSv1.2
spring.servlet.multipart.max-file-size=15MB
spring.servlet.multipart.max-request-size=45MB

# Startup sequence synchronization
app.sequence-sync.enabled=true
app.sequence-sync.include-auto-discovered=true
app.sequence-sync.audit-coverage=true
app.sequence-sync.fail-on-uncovered=false
app.sequence-sync.schema=public
app.sequence-sync.manual-targets[0].schema=public
app.sequence-sync.manual-targets[0].table=mst_mat
app.sequence-sync.manual-targets[0].column=mat_cd
app.sequence-sync.manual-targets[0].sequence=mat_cd_seq
app.sequence-sync.manual-targets[0].prefix=MT
app.sequence-sync.manual-targets[1].schema=public
app.sequence-sync.manual-targets[1].table=mst_fd
app.sequence-sync.manual-targets[1].column=fd_cd
app.sequence-sync.manual-targets[1].sequence=usr_fd_cd_seq
app.sequence-sync.manual-targets[1].prefix=UF
